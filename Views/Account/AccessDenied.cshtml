@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="cf-card p-5">
                <div class="text-danger mb-3" style="font-size: 3rem;">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h2 class="font-serif mb-2">Access Denied</h2>
                <p class="text-muted mb-4">
                    You do not possess the required administrative authorization to access this protected sector.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Return to Dashboard</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Homepage</a>
                </div>
            </div>
        </div>
    </div>
</div>
