@model CareerFit.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Free Candidate Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="cf-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded mb-2" style="width: 44px; height: 44px; font-weight: 700; font-family: var(--font-heading); font-size: 1.25rem;">
                        CF
                    </span>
                    <h2 class="font-serif mb-1">Create Your Account</h2>
                    <p class="text-muted small">Begin your career evaluation with personalized recommendations.</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-color text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="Jane Doe" autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-color text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="jane.doe@example.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-color text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="At least 6 chars" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-color text-muted"><i class="bi bi-shield-check"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="AgreeTerms" class="form-check-input" />
                        <label asp-for="AgreeTerms" class="form-check-label small text-muted">
                            I understand that CareerFit uses a rule-based explainable matching algorithm for educational and career advisory purposes.
                        </label>
                        <span asp-validation-for="AgreeTerms" class="text-danger small d-block"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary py-2">
                            <i class="bi bi-person-check me-2"></i> Register Account
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-subtle small">
                    <span class="text-muted">Already registered?</span>
                    <a asp-controller="Account" asp-action="Login" class="fw-semibold text-primary ms-1">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
