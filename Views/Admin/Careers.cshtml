@model List<CareerFit.Models.Career>
@{
    ViewData["Title"] = "Manage Career Database";
}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-color">
        <div>
            <div class="section-heading-eyebrow text-danger"><i class="bi bi-briefcase me-1"></i> Career Catalogue Management</div>
            <h1 class="font-serif mb-1">Career Profiles Database (@Model.Count)</h1>
            <p class="text-muted small mb-0">Create, modify, update skill mappings, and manage active career profiles.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="CareerCreate" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Career
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Admin Dashboard
            </a>
        </div>
    </div>

    <div class="cf-card p-4">
        <div class="table-responsive">
            <table class="table table-careerfit mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Seniority</th>
                        <th>Benchmark Salary</th>
                        <th>Skills</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Career" asp-action="Details" asp-route-id="@c.Id" class="text-primary text-decoration-none" target="_blank">
                                    @c.Title
                                </a>
                            </td>
                            <td><span class="badge-tag">@c.Category</span></td>
                            <td><span class="badge bg-light text-dark border small">@c.ExperienceLevel</span></td>
                            <td class="small fw-semibold">$@c.SalaryMin.ToString("N0") - $@c.SalaryMax.ToString("N0")</td>
                            <td><span class="badge bg-light text-muted border small">@c.CareerSkills.Count Skills</span></td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success small">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary small">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="CareerEdit" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm py-0 px-2 me-1" title="Edit Profile">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-action="CareerDelete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @c.Title?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Delete Profile">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
