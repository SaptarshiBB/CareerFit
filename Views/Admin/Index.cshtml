@model CareerFit.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Platform Administration Portal";
    var stats = Model.Stats;
}

<div class="container-fluid px-lg-4 py-4">
    <!-- Admin Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-color">
        <div>
            <div class="section-heading-eyebrow text-danger"><i class="bi bi-shield-lock me-1"></i> Admin Management Portal</div>
            <h1 class="font-serif mb-1">CareerFit Governance & Analytics</h1>
            <p class="text-muted small mb-0">Platform overview, database statistics, user records, and career catalogue administration.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="CareerCreate" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Add New Career Profile
            </a>
            <a asp-action="Careers" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-briefcase me-1"></i> Manage Careers
            </a>
            <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-people me-1"></i> Manage Users
            </a>
        </div>
    </div>

    <!-- Metric Counters Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="cf-card p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Total Registered Users</span>
                        <div class="fw-bold fs-3 text-primary font-serif">@stats.TotalUsers</div>
                    </div>
                    <div class="p-3 bg-light rounded text-primary fs-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="cf-card p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Assessments Completed</span>
                        <div class="fw-bold fs-3 text-primary font-serif">@stats.TotalAssessments</div>
                    </div>
                    <div class="p-3 bg-light rounded text-success fs-3">
                        <i class="bi bi-clipboard2-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="cf-card p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Career Catalogue</span>
                        <div class="fw-bold fs-3 text-primary font-serif">@stats.TotalCareers</div>
                    </div>
                    <div class="p-3 bg-light rounded text-info fs-3">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="cf-card p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Active Industry Skills</span>
                        <div class="fw-bold fs-3 text-primary font-serif">@stats.TotalSkills</div>
                    </div>
                    <div class="p-3 bg-light rounded text-warning fs-3">
                        <i class="bi bi-tools"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics Chart & Top Careers -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="cf-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-serif mb-0"><i class="bi bi-bar-chart-line me-1 text-primary"></i> Most Recommended Career Roles</h5>
                    <span class="text-muted small">Recommendation Frequency</span>
                </div>
                <div style="height: 280px;">
                    <canvas id="adminAnalyticsChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="cf-card p-4 h-100">
                <h5 class="font-serif mb-3"><i class="bi bi-award me-1 text-primary"></i> Recommendation Leaders</h5>
                <div class="list-group list-group-flush">
                    @foreach (var rec in stats.TopRecommendedCareers)
                    {
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold text-primary small">@rec.CareerTitle</span>
                                <span class="text-muted small d-block">@rec.Category</span>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary">@rec.RecommendationCount Recs</span>
                                <span class="text-muted small d-block">Avg @rec.AverageScore%</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Registrations & Quick Management Links -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="cf-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-serif mb-0"><i class="bi bi-person-lines-fill me-1 text-primary"></i> Recent Candidate Registrations</h5>
                    <a asp-action="Users" class="small text-decoration-none">View All Users</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-careerfit small mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Registered</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in stats.RecentUsers)
                            {
                                <tr>
                                    <td class="fw-semibold">@u.FullName</td>
                                    <td>@u.Email</td>
                                    <td class="text-muted">@u.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="cf-card p-4">
                <h5 class="font-serif mb-3"><i class="bi bi-sliders me-1 text-primary"></i> Quick Administration</h5>
                <div class="d-grid gap-2">
                    <a asp-action="Careers" class="btn btn-outline-primary text-start">
                        <i class="bi bi-briefcase me-2"></i> Manage Careers Database (@stats.TotalCareers)
                    </a>
                    <a asp-action="Skills" class="btn btn-outline-primary text-start">
                        <i class="bi bi-tools me-2"></i> Manage Skill Catalog (@stats.TotalSkills)
                    </a>
                    <a asp-action="Questions" class="btn btn-outline-primary text-start">
                        <i class="bi bi-question-circle me-2"></i> Manage Assessment Questions
                    </a>
                    <a asp-action="Users" class="btn btn-outline-primary text-start">
                        <i class="bi bi-people me-2"></i> View User Registry (@stats.TotalUsers)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('adminAnalyticsChart');
            if (!ctx) return;

            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.TopRecommendedCareers.Select(x => x.CareerTitle)));
            const dataCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.TopRecommendedCareers.Select(x => x.RecommendationCount)));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels.length > 0 ? labels : ['Software Developer', '.NET Developer', 'Data Scientist', 'Cloud Engineer', 'DevOps Engineer'],
                    datasets: [{
                        label: 'Recommendation Invocations',
                        data: dataCounts.length > 0 ? dataCounts : [12, 10, 8, 7, 5],
                        backgroundColor: '#172B4D',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        });
    </script>
}
