@model CareerFit.ViewModels.CareerIndexViewModel
@{
    ViewData["Title"] = "Explore Career Catalogue";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-color">
        <div>
            <div class="section-heading-eyebrow">Database-Driven Catalogue</div>
            <h1 class="font-serif mb-1">Explore Career Pathways</h1>
            <p class="text-muted small mb-0">Browse @Model.TotalCount professional profiles benchmarked against real industry requisites.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Career" asp-action="Compare" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-bar-chart-steps me-1"></i> Side-by-Side Comparison
            </a>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="cf-card p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-lg-4 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-color text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by title, skill, or keyword..." value="@Model.SearchTerm" />
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <select name="category" class="form-select" onchange="this.form.submit()">
                    <option value="All">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.SelectedCategory == cat)
                        {
                            <option value="@cat" selected>@cat</option>
                        }
                        else
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-2 col-md-6">
                <select name="experience" class="form-select" onchange="this.form.submit()">
                    <option value="All">All Seniorities</option>
                    @foreach (var exp in Model.ExperienceLevels)
                    {
                        if (Model.SelectedExperience == exp)
                        {
                            <option value="@exp" selected>@exp</option>
                        }
                        else
                        {
                            <option value="@exp">@exp</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-2 col-md-6">
                <select name="sortBy" class="form-select" onchange="this.form.submit()">
                    <option value="">Sort: A to Z</option>
                    <option value="title_desc" selected="@(Model.SortBy == "title_desc")">Sort: Z to A</option>
                    <option value="salary_high" selected="@(Model.SortBy == "salary_high")">Highest Salary</option>
                    <option value="salary_low" selected="@(Model.SortBy == "salary_low")">Lowest Salary</option>
                    <option value="demand" selected="@(Model.SortBy == "demand")">Highest Demand</option>
                </select>
            </div>

            <div class="col-lg-1 col-12 d-grid">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>

    <!-- Career Cards Grid -->
    @if (Model.Careers.Any())
    {
        <div class="row g-4">
            @foreach (var career in Model.Careers)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="cf-card h-100 d-flex flex-column">
                        <div class="cf-card-header d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge-tag mb-2">@career.Category</span>
                                <h5 class="mb-1">
                                    <a asp-action="Details" asp-route-id="@career.Id" class="text-decoration-none text-dark">@career.Title</a>
                                </h5>
                            </div>
                            <span class="badge bg-light text-muted border small">
                                @career.ExperienceLevel
                            </span>
                        </div>
                        <div class="cf-card-body flex-grow-1">
                            <p class="text-muted small mb-3">@career.Summary</p>

                            <div class="mb-3">
                                <span class="text-muted small d-block mb-1 fw-semibold">Key Prerequisites:</span>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var cs in career.CareerSkills.Take(4))
                                    {
                                        <span class="badge bg-light text-dark border small">@cs.Skill?.Name</span>
                                    }
                                </div>
                            </div>

                            <div class="pt-2 border-top border-subtle">
                                <span class="text-muted small d-block">Illustrative Salary Benchmark:</span>
                                <span class="fw-bold text-primary">
                                    $@career.SalaryMin.ToString("N0") - $@career.SalaryMax.ToString("N0") <span class="small text-muted fw-normal">USD/yr</span>
                                </span>
                            </div>
                        </div>
                        <div class="p-3 border-top border-color bg-light d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@career.Id" class="btn btn-outline-primary btn-sm">
                                View Profile
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="Compare" asp-route-career1Id="@career.Id" class="btn btn-light btn-sm border text-muted" title="Compare side by side">
                                    <i class="bi bi-bar-chart-steps"></i>
                                </a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="SavedCareer" asp-action="Toggle" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="careerId" value="@career.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-light btn-sm border text-muted" title="Bookmark career">
                                            <i class="bi bi-bookmark"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="cf-card p-5 text-center my-4">
            <i class="bi bi-search text-muted fs-1 mb-2 d-block"></i>
            <h4 class="font-serif">No Career Profiles Match Your Filters</h4>
            <p class="text-muted small mb-3">Try adjusting your search criteria or resetting filters.</p>
            <a asp-action="Index" class="btn btn-outline-primary btn-sm">Reset All Filters</a>
        </div>
    }
</div>
