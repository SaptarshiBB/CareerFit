@{
    ViewData["Title"] = "About CareerFit";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="section-heading-eyebrow">About CareerFit</div>
            <h1 class="display-5 font-serif mb-3">Matching Candidates with Suitable Careers</h1>
            <p class="lead text-muted mb-5">
                CareerFit was established to eliminate ambiguity in professional career transitions, university graduate placement, and engineering skill development.
            </p>

            <div class="cf-card mb-4 p-4">
                <h4 class="font-serif text-primary mb-3">Our Mission</h4>
                <p class="text-muted">
                    In a rapidly shifting technological landscape, candidates frequently struggle to identify which roles genuinely fit their core strengths. CareerFit delivers an objective, benchmark-driven career guidance system that connects individual competencies with industry-verified job specifications.
                </p>
            </div>

            <div class="cf-card mb-4 p-4">
                <h4 class="font-serif text-primary mb-3">Architectural Principles</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-primary mb-2"><i class="bi bi-shield-check me-2"></i> Explainable Intelligence</h6>
                            <p class="text-muted small mb-0">Every recommendation is paired with transparent rationale, identified skill matches, and prioritized gap remediation.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-primary mb-2"><i class="bi bi-database-check me-2"></i> Self-Contained Reliability</h6>
                            <p class="text-muted small mb-0">Engineered with ASP.NET Core MVC (.NET 10) and SQLite for zero external cloud dependency or external API keys.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-primary mb-2"><i class="bi bi-map me-2"></i> Actionable Growth Paths</h6>
                            <p class="text-muted small mb-0">Beyond static suggestions, candidates receive customized, stage-by-stage learning milestones with capstone ideas.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border h-100">
                            <h6 class="text-primary mb-2"><i class="bi bi-person-badge me-2"></i> Role-Based Governance</h6>
                            <p class="text-muted small mb-0">Secure ASP.NET Core Identity authentication with strict separation of Candidate and Administrative operations.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cf-card p-4 text-center">
                <h5 class="font-serif mb-2">Explore the Platform</h5>
                <p class="text-muted small mb-3">
                    Ready to evaluate your skills or inspect our catalog of 20+ specialized career paths?
                </p>
                <div>
                    <a asp-controller="Career" asp-action="Index" class="btn btn-outline-primary btn-sm me-2">Browse Career Catalog</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Get Started</a>
                </div>
            </div>
        </div>
    </div>
</div>
