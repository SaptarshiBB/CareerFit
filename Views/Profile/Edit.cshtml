@model CareerFit.ViewModels.CandidateProfileViewModel
@{
    ViewData["Title"] = "Edit Candidate Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-color">
                <div>
                    <div class="section-heading-eyebrow">Profile Management</div>
                    <h2 class="font-serif mb-0">Update Candidate Information</h2>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Profile
                </a>
            </div>

            <form asp-action="Edit" method="post" class="cf-card p-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <h5 class="font-serif text-primary border-bottom border-subtle pb-2 mb-3">1. Personal & Contact Details</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+1 (555) 000-0000" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <h5 class="font-serif text-primary border-bottom border-subtle pb-2 mb-3">2. Education & Academic Background</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="HighestEducation" class="form-label"></label>
                        <select asp-for="HighestEducation" class="form-select">
                            <option value="High School">High School Diploma / GED</option>
                            <option value="Associate Degree">Associate Degree / Diploma</option>
                            <option value="Bachelor's Degree">Bachelor's Degree</option>
                            <option value="Master's Degree">Master's Degree</option>
                            <option value="Doctorate / PhD">Doctorate / PhD</option>
                        </select>
                        <span asp-validation-for="HighestEducation" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GraduationYear" class="form-label"></label>
                        <input asp-for="GraduationYear" class="form-control" placeholder="e.g. 2024" />
                        <span asp-validation-for="GraduationYear" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Degree" class="form-label"></label>
                        <input asp-for="Degree" class="form-control" placeholder="e.g. B.S. in Computer Science" />
                        <span asp-validation-for="Degree" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Specialization" class="form-label"></label>
                        <input asp-for="Specialization" class="form-control" placeholder="e.g. Software Engineering, Data Analytics" />
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                </div>

                <h5 class="font-serif text-primary border-bottom border-subtle pb-2 mb-3">3. Work Experience & Career Preferences</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="ExperienceLevel" class="form-label"></label>
                        <select asp-for="ExperienceLevel" class="form-select">
                            <option value="Entry-Level">Entry-Level (0-2 years)</option>
                            <option value="Mid-Level">Mid-Level (3-5 years)</option>
                            <option value="Senior">Senior (5+ years)</option>
                        </select>
                        <span asp-validation-for="ExperienceLevel" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="YearsOfExperience" class="form-label"></label>
                        <input asp-for="YearsOfExperience" class="form-control" type="number" min="0" max="50" />
                        <span asp-validation-for="YearsOfExperience" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PreferredWorkEnvironment" class="form-label"></label>
                        <select asp-for="PreferredWorkEnvironment" class="form-select">
                            <option value="Hybrid">Hybrid</option>
                            <option value="Remote">Remote</option>
                            <option value="On-site">On-site</option>
                            <option value="Flexible">Flexible</option>
                        </select>
                        <span asp-validation-for="PreferredWorkEnvironment" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PreferredWorkDomain" class="form-label"></label>
                        <input asp-for="PreferredWorkDomain" class="form-control" placeholder="e.g. Information Technology, Healthcare, Finance" />
                        <span asp-validation-for="PreferredWorkDomain" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="CareerInterests" class="form-label"></label>
                        <input asp-for="CareerInterests" class="form-control" placeholder="Comma-separated: Software Development, Cloud Computing, Cybersecurity" />
                        <span class="text-muted small">Enter domains separated by commas.</span>
                    </div>
                    <div class="col-12">
                        <label asp-for="WorkExperience" class="form-label"></label>
                        <textarea asp-for="WorkExperience" class="form-control" rows="4" placeholder="Briefly describe your responsibilities, key internships, or major projects..."></textarea>
                        <span asp-validation-for="WorkExperience" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top border-color">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
