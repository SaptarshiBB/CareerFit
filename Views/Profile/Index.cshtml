@model CareerFit.ViewModels.CandidateProfileViewModel
@{
    ViewData["Title"] = "My Candidate Profile";
    var availableSkills = (List<CareerFit.Models.Skill>)(ViewBag.AvailableSkills ?? new List<CareerFit.Models.Skill>());
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-color">
        <div>
            <div class="section-heading-eyebrow">Candidate Portfolio</div>
            <h2 class="font-serif mb-1">@Model.FullName</h2>
            <p class="text-muted small mb-0"><i class="bi bi-envelope me-1"></i> @Model.Email &bull; <i class="bi bi-geo me-1"></i> @Model.PreferredWorkDomain</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="Edit" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil-square me-1"></i> Edit Profile Information
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Profile Completeness Bar -->
    <div class="cf-card mb-4 p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold small"><i class="bi bi-award me-1 text-primary"></i> Profile Completeness</span>
            <span class="badge bg-primary">@Model.CompletionPercentage%</span>
        </div>
        <div class="progress" style="height: 8px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.CompletionPercentage%;" aria-valuenow="@Model.CompletionPercentage" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        @if (Model.CompletionPercentage < 80)
        {
            <div class="small text-muted mt-2">
                <i class="bi bi-lightbulb me-1 text-warning"></i> Add your skills, degree specialization, and career interests to maximize career matching precision.
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Left Column: Academic & Background Details -->
        <div class="col-lg-7">
            <div class="cf-card mb-4">
                <div class="cf-card-header d-flex justify-content-between align-items-center">
                    <h5 class="font-serif mb-0"><i class="bi bi-mortarboard me-2 text-primary"></i> Academic & Professional Credentials</h5>
                    <a asp-action="Edit" class="small text-decoration-none">Edit</a>
                </div>
                <div class="cf-card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Highest Education</span>
                            <span class="fw-semibold">@Model.HighestEducation</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Graduation Year</span>
                            <span class="fw-semibold">@(Model.GraduationYear?.ToString() ?? "Not specified")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Degree / Major</span>
                            <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Degree) ? "Not specified" : Model.Degree)</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Specialization</span>
                            <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Specialization) ? "General" : Model.Specialization)</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Experience Level</span>
                            <span class="badge bg-light text-dark border">@Model.ExperienceLevel (@Model.YearsOfExperience yrs)</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Preferred Work Setup</span>
                            <span class="badge bg-light text-dark border">@Model.PreferredWorkEnvironment</span>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small d-block mb-1">Work Experience Summary</span>
                            <div class="p-3 bg-light rounded border small">
                                @(string.IsNullOrWhiteSpace(Model.WorkExperience) ? "No detailed work history recorded yet. Click 'Edit Profile' to document your background." : Model.WorkExperience)
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Career Interests & Preferences -->
            <div class="cf-card mb-4">
                <div class="cf-card-header">
                    <h5 class="font-serif mb-0"><i class="bi bi-compass me-2 text-primary"></i> Target Domains & Interests</h5>
                </div>
                <div class="cf-card-body">
                    <div class="mb-3">
                        <span class="text-muted small d-block mb-2">Preferred Career Disciplines</span>
                        @if (!string.IsNullOrWhiteSpace(Model.CareerInterests))
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var interest in Model.CareerInterests.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="badge-tag"><i class="bi bi-tag me-1"></i> @interest</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">No target interests designated yet.</span>
                        }
                    </div>

                    <div>
                        <span class="text-muted small d-block">Preferred Industry Domain</span>
                        <span class="fw-semibold">@Model.PreferredWorkDomain</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Skills Management -->
        <div class="col-lg-5">
            <div class="cf-card mb-4">
                <div class="cf-card-header d-flex justify-content-between align-items-center">
                    <h5 class="font-serif mb-0"><i class="bi bi-tools me-2 text-primary"></i> Possessed Skills (@Model.CurrentSkills.Count)</h5>
                </div>
                <div class="cf-card-body">
                    @if (Model.CurrentSkills.Any())
                    {
                        <div class="list-group list-group-flush mb-4">
                            @foreach (var us in Model.CurrentSkills)
                            {
                                <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-semibold">@us.Skill?.Name</span>
                                        <span class="badge bg-light text-muted border small ms-1">@us.Skill?.Category</span>
                                        <div class="small text-muted">@us.ProficiencyLevel &bull; @us.YearsOfExperience yr(s) exp</div>
                                    </div>
                                    <form asp-action="RemoveSkill" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userSkillId" value="@us.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Remove Skill">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-cpu fs-3 d-block mb-2"></i>
                            No skills cataloged on your profile yet. Add your core competencies below.
                        </div>
                    }

                    <!-- Add Skill Form -->
                    <div class="p-3 bg-light rounded border">
                        <h6 class="fw-semibold mb-3"><i class="bi bi-plus-circle me-1 text-primary"></i> Add Competency</h6>
                        <form asp-action="AddSkill" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <label class="form-label small">Select Skill</label>
                                <select name="skillId" class="form-select form-select-sm" required>
                                    <option value="">-- Choose Skill --</option>
                                    @foreach (var sk in availableSkills)
                                    {
                                        <option value="@sk.Id">@sk.Name (@sk.Category)</option>
                                    }
                                </select>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-7">
                                    <label class="form-label small">Proficiency</label>
                                    <select name="proficiencyLevel" class="form-select form-select-sm">
                                        <option value="Beginner">Beginner</option>
                                        <option value="Intermediate" selected>Intermediate</option>
                                        <option value="Advanced">Advanced</option>
                                    </select>
                                </div>
                                <div class="col-5">
                                    <label class="form-label small">Years Exp</label>
                                    <input type="number" name="yearsOfExperience" class="form-control form-control-sm" value="1" min="0" max="30" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                Add to Profile
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
