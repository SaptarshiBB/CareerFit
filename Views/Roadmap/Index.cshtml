@model List<CareerFit.Models.Roadmap>
@{
    ViewData["Title"] = "My Career Learning Roadmaps";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-color">
        <div>
            <div class="section-heading-eyebrow">Structured Mastery Paths</div>
            <h1 class="font-serif mb-1">My Career Roadmaps</h1>
            <p class="text-muted small mb-0">Track your progression across Beginner, Intermediate, and Advanced milestones.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Career" asp-action="Index" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Roadmap from Careers
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var rm in Model)
            {
                var completedCount = rm.Milestones.Count(m => m.IsCompleted);
                var totalCount = rm.Milestones.Count;
                var progressPct = totalCount > 0 ? (int)Math.Round((double)completedCount / totalCount * 100) : 0;

                <div class="col-lg-6">
                    <div class="cf-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge-tag mb-1">@(rm.Career?.Category ?? "Technology")</span>
                                <h4 class="font-serif mb-1">
                                    <a asp-action="Details" asp-route-id="@rm.Id" class="text-primary text-decoration-none">
                                        @rm.TargetRole
                                    </a>
                                </h4>
                            </div>
                            <span class="badge bg-light text-dark border">
                                @completedCount / @totalCount Done
                            </span>
                        </div>

                        <p class="text-muted small mb-3">@rm.Summary</p>

                        <!-- Progress Bar -->
                        <div class="mb-4 mt-auto">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Roadmap Progress</span>
                                <span class="fw-bold text-primary">@progressPct%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @progressPct%;" aria-valuenow="@progressPct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-subtle">
                            <span class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i> Created @rm.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                            <a asp-action="Details" asp-route-id="@rm.Id" class="btn btn-outline-primary btn-sm">
                                Open Roadmap <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="cf-card p-5 text-center my-4">
            <i class="bi bi-map text-muted fs-1 mb-2 d-block"></i>
            <h4 class="font-serif">No Active Learning Roadmaps</h4>
            <p class="text-muted small mb-4 mx-auto" style="max-width: 500px;">
                Generate customized 3-stage learning roadmaps from your career assessment results or directly from any role in our career catalogue.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Career" asp-action="Index" class="btn btn-primary btn-sm">
                    Browse Careers
                </a>
                <a asp-controller="Assessment" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    Take Assessment
                </a>
            </div>
        </div>
    }
</div>
