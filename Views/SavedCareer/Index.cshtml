@model List<CareerFit.Models.SavedCareer>
@{
    ViewData["Title"] = "My Saved Career Bookmarks";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-color">
        <div>
            <div class="section-heading-eyebrow">Personal Bookmarks</div>
            <h1 class="font-serif mb-1">Saved Careers (@Model.Count)</h1>
            <p class="text-muted small mb-0">Manage your shortlisted career pathways for focused evaluation and roadmap planning.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Career" asp-action="Index" class="btn btn-primary btn-sm">
                <i class="bi bi-compass me-1"></i> Explore More Careers
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var sc in Model)
            {
                var c = sc.Career;
                if (c == null) continue;

                <div class="col-lg-4 col-md-6">
                    <div class="cf-card h-100 d-flex flex-column">
                        <div class="cf-card-header d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge-tag mb-2">@c.Category</span>
                                <h5 class="mb-1">
                                    <a asp-controller="Career" asp-action="Details" asp-route-id="@c.Id" class="text-dark text-decoration-none">
                                        @c.Title
                                    </a>
                                </h5>
                            </div>
                            <form asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@sc.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Remove Bookmark">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>

                        <div class="cf-card-body flex-grow-1">
                            <p class="text-muted small mb-3">@c.Summary</p>

                            <div class="mb-3">
                                <span class="text-muted small d-block mb-1 fw-semibold">Required Skills:</span>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var cs in c.CareerSkills.Take(4))
                                    {
                                        <span class="badge bg-light text-dark border small">@cs.Skill?.Name</span>
                                    }
                                </div>
                            </div>

                            <div class="pt-2 border-top border-subtle">
                                <span class="text-muted small d-block">Compensation Benchmark:</span>
                                <span class="fw-bold text-primary">
                                    $@c.SalaryMin.ToString("N0") - $@c.SalaryMax.ToString("N0") <span class="small text-muted fw-normal">USD/yr</span>
                                </span>
                            </div>
                        </div>

                        <div class="p-3 border-top border-color bg-light d-flex justify-content-between align-items-center">
                            <a asp-controller="Career" asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">
                                View Profile
                            </a>
                            <a asp-controller="SkillGap" asp-action="Index" asp-route-careerId="@c.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-graph-up-arrow me-1"></i> Skill Gap
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="cf-card p-5 text-center my-4">
            <i class="bi bi-bookmark-plus text-muted fs-1 mb-2 d-block"></i>
            <h4 class="font-serif">No Careers Bookmarked Yet</h4>
            <p class="text-muted small mb-3">Explore our career catalogue and click "Bookmark Role" on any career to save it here.</p>
            <a asp-controller="Career" asp-action="Index" class="btn btn-primary btn-sm">Browse All Careers</a>
        </div>
    }
</div>
